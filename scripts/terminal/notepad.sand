@override
start additionalUpdate()
    refreshWindowWithCameraNotepad()
end

@trigger on_mouse_pressing
start _checkIfWindowMovedNotepad()
    if (mouse_moved && mouse_pressing(0))
        all Cameras _ camera _ Cameras
        find_by_id_2 Cameras cameraID Camera
        refreshWindowWithCameraNotepad()
    end_if
end

@trigger on_display_resize
start checkIfDisplayResizeNotepad()
    if (isMaxed)
        refreshWindowWithDisplayNotepad()
    end_if
end


start refreshWindowWithDisplayNotepad()
    all Cameras _ camera _ Cameras
    find_by_id_2 Cameras cameraID Camera
    int sx 0
    int sy 0
    access sx [display_w]
    access sy [display_h]
    fun Camera resize sx sy
    refreshWindowNotepad(sx, sy)
end

start refreshWindowWithCameraNotepad()
    all Cameras _ camera _ Cameras
    find_by_id_2 Cameras cameraID Camera
    int sx 0
    int sy 0
    access sx [Camera.size_x]
    access sy [Camera.size_y]
    refreshWindowNotepad(sx, sy)
end


start refreshWindowNotepad(double &sx, double &sy)
    access myLayerID [me.layer_id]
    all Layers _ _ _ _ _ _ Layers
    find_by_id_2 Layers myLayerID Layer
    index Layer [0 0 0] super_editable_text Notepad
    fun Notepad set_size sx sy
    //fun Notepad update
    resizeObjectWhenNotBorderless(sx, sy)
end

start resizeObjectWhenNotBorderless(double &sx, double &sy)
    if (!isBorderless)
        index my_layer [0 0] object WindowObject
        fun WindowObject set_size sx sy
        //fun Notepad update
    end_if
end

@trigger on_mouse_release
start resizeObjectWhenMaxed()
    if (mouse_released(0))
        index my_layer [0 0 1] collision MaxCollision
        if(MaxCollision.release_on)
            all Cameras _ camera _ Cameras
            find_by_id_2 Cameras cameraID Camera
            int sx 0
            int sy 0
            access sx [Camera.size_x]
            access sy [Camera.size_y]
            index my_layer [0 0] object WindowObject
            fun WindowObject set_size sx sy
            index my_layer [0 0 0] super_editable_text Notepad
            fun Notepad update
        end_if
    end_if
end

@trigger on_key_press
start resizeObjectWhenSwitchingToBorderlessMode()
    if (key_pressed(KEY_F11))
        all Cameras _ camera _ Cameras
        find_by_id_2 Cameras cameraID Camera
        if(Camera.is_focused)
            resizeObjectForBorderlessMode(Camera)
        end_if
    end_if
end

start resizeObjectForBorderlessMode(Camera &Camera)
    if (isBorderless)
        int cpx 0
        int cpy 0
        access cpx [Camera.size_x]
        access cpy [Camera.size_y]
        int shiftX 10
        int shiftY 40
        += cpx shiftX
        += cpy shiftY
        index my_layer [0 0] object WindowObject
        fun WindowObject set_size cpx cpy
        index my_layer [0 0 0] super_editable_text Notepad
        fun Notepad update
    else 
        resizeObjectFromBorderlessMode(Camera)
    end_if
end

start resizeObjectFromBorderlessMode(Camera &Camera)
    int cpx 0
    int cpy 0
    access cpx [Camera.size_x]
    access cpy [Camera.size_y]
    index my_layer [0 0] object WindowObject
    fun WindowObject set_size cpx cpy
    index my_layer [0 0 0] super_editable_text Notepad
    fun Notepad update
end