start newLine
    string result "\n"
    run printOnTerminal(result)
end
start nextTest
    run printPrompt()
    run newLine()
end
start testSpawn
    string param1 "elephant"
    run spawn()
end
start testNote
    //string param1 "history.txt"
    string param1 "examples/hello.sand"
    run note()
end
start testMover
    string param1 "KERNEL"
    run mover()
end
start testCat
    string param1 ".config"
    run cat()
end
start testPrint
    string param1 "TEST TEST TEST\n"
    run print()
end
start testEdit
    string param1 "docs/TODO.txt"
    run edit()
end
start testSand
    string param1 "scripts/lorem.sand"
    run sand()
end
start testCd
    string param1 "scripts"
    run cd()
end
start testCd2
    string param1 ""
    run cd()
end
start testSaveLoadTerminal
    mkdir "temp"
    string param1 "temp/test.ft"
    run save_terminal()
    run load_terminal
end
start dvd
    = param1 "scripts/dvd.sand"
    run sand()
end
