start init
    triggers on_init
    int x 10
    print _ _ "init: Number is " x "\n"
    run if_0(x)
after
    print _ _ "after init: Number is " x "\n"
    exit
end

start if_0(int x)
    if([x] [10] ==)
    else else_0(x)
    print "if_0: Number is 10.\n"
    += x 10
    run if_1(x)
after
    print _ _ "after if_0: Number is " x "\n"
end

start else_0(int x)
    print _ _ "Incorrect Number: " x "\n"
    = x 400
end

start if_1(int x)
    print _ _ "if_1: Number is " x ".\n"
    += x 10
after
    print _ _ "after if_1: Number is " x "\n"
end