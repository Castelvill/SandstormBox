@trigger on_init
start onInit()
    //edit_proc print_instructions 1
    edit_proc auto_print_stack 0

    start_timer "fullProgramTimer"
    
    var SCREEN_W 640
    var SCREEN_H 480
    create_display SCREEN_W SCREEN_H SCREEN_W SCREEN_H

    var GAME_MAP_W 70
    var GAME_MAP_H 22
    var GAME_MAP_SIZE GAME_MAP_W
    *= GAME_MAP_SIZE GAME_MAP_H
    print "Game map size: " GAME_MAP_SIZE "\n"
    var MAX_ITEMS 200

    fun me set_can_be_selected false

    new Cameras 1 "Camera" Camera
    //fun Camera set_active true
    fun Camera resize SCREEN_W SCREEN_H
    fun Camera set_zoom 1.0
    fun Camera set_speed 0
    fun Camera add_visible_layer "KERNEL"
    fun Camera add_accessible_layer "KERNEL"
    fun Camera set_tint 1.0 1.0 1.0 1.0
    fun Camera set_is_vision_affected_by_mouse false
    fun Camera set_can_zoom_with_mouse false
    fun Camera set_can_move_with_keyboard false
    fun Camera set_can_zoom_with_keyboard false
    fun Camera set_drawing_borders false
    fun Camera focus

    load_font "fonts/CascadiaCode.ttf" 16 "cascadia_code" true

    new STexts me 1 "TextField" TextField
    fun TextField set_size SCREEN_W SCREEN_H
    fun TextField add_format "cascadia_code" 1
    fun TextField set_last_color 0.8 0.8 0.8 1.0
    fun TextField set_last_accent_color 0.5 0.5 0.5 1.0
    fun TextField set_wrapping "w"
    fun TextField set_content "robotfindskitten-sand\nInspired by the illustrious Leonard Richardson (C) 1997, 2000\n\nIn this game, you are robot (#). Your job is to find kitten. This task\nis complicated by the existence of various things which are not kitten.\nRobot must touch items to determine if they are kitten or not. The game\nends when robotfindskitten. Alternatively, you may end the game by hitting the Esc key.\n\nPress any key to start"
    fun TextField update

    var gameState 0

    var counter 0

    var playerX 0
    var playerY 0
    vec int nonKittenPos []
end

@trigger on_key_press
@trigger each_iteration
start eachIteration
    index me [0 0] super_text TextField
    
    run startGame()
    run drawScene(TextField)
end

start startGame()
    if(gameState 0 !=)
        return
    end_if
    = gameState 1
    int index 0
    fun nonKittenPos clear
    
    while(index MAX_ITEMS <)
        random_int 0 GAME_MAP_SIZE randomPos
        fun nonKittenPos push_back randomPos
        next index
    end_while
end

start drawScene(SText TextField)
    if(gameState 1 !=)
        return
    end_if

    fun TextField set_content "robotfindskitten-sand\n\n_______________________________________________________________________"
    
    run drawItems(TextField)

    print "Iteration number: " counter "\n"
    fun TextField set_size SCREEN_W SCREEN_H
    fun TextField update
    int seconds 0
    stop_timer "fullProgramTimer" seconds
    print "Total time of processing: " seconds "s.\n"
    //exit
end

start drawItems(SText TextField)
    int index -1
    while(index GAME_MAP_SIZE <)
        int item 0
        bool hit false
        while(item MAX_ITEMS <)
            index_vec nonKittenPos item pos
            next counter
            if(pos index ==)
                fun TextField add_content "X"
                = hit true
                break
            end_if
            next item
        end_while
        if(hit !)
            fun TextField add_content " "
        end_if
        next index
    end_while
end