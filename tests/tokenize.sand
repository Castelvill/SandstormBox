import "tests/test_template.sand"

start main()
    triggers on_init
    run startTest()

    tokenize " " "a b c d e" xd
    print_v output0 "-" xd "\n"
    assert output0 "a-b-c-d-e-\n"

    tokenize " " "a b c d e" [varA varB varC varD varE]
    print_v output1 "+" varA varB varC varD varE "\n"
    assert output1 "a+b+c+d+e+\n"

    run endTest()
end