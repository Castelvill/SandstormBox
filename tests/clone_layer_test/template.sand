@trigger on_init
start onInit()
    access myName [self.id]
    if(myName == "Template")
        assert 1 0
    end

    ++ var0
    assert var0 16

    decrementLock()

    //print "Hello from " self_layer ":" myName ": " var0 "\n"
end

start decrementLock()
    var idleLock 0
    all Layer _ _ _ _ _ _ layers
    find_by_id_2 layers testLayerName testLayer
    first testLayer _ _ _ _ Object _ objects
    find_by_id_2 objects testObjName testObj
    first testObj _ _ var idleLock _ _ idleLock
    -- idleLock
end