import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    string varType ""

    val value
    type value varType
    assert varType "val"
    setVal(value)
    checkVal(value)

    ptr pointer
    type pointer varType
    assert varType "ptr"

    Object object
    type object varType
    assert varType "Object"

    any anyVar
    type anyVar varType
    assert varType "any"
    
    endTest()
end

start setVal(val & value)
    fun value set_int 5
end

start checkVal(val & value)
    assert value 5
end