import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    string varType ""

    Val val
    type val varType
    assert varType "Val"
    setVal(val)
    checkVal(val)

    Pointer ptr
    type ptr varType
    assert varType "Pointer"

    Object Obj
    type Obj varType
    assert varType "Object"

    any anyVar
    type anyVar varType
    assert varType "any"
    
    endTest()
end

start setVal(Val & val)
    fun val set_int 5
end

start checkVal(Val & val)
    assert val 5
end