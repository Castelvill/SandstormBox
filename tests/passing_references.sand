import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    int x 0
    assert x 0
    val(x)
    assert x 0
    ref(x)
    assert x 2
    valToVal(x)
    assert x 2
    valToRef(x)
    assert x 2
    refToVal(x)
    assert x 5
    refToRef(x)
    assert x 8

    endTest()
end

start val(int x)
    assert x 0
    = x 1
    assert x 1
end

start ref(int & x)
    assert x 0
    = x 2
    assert x 2
end

start valToVal(int x)
    assert x 2
    = x 3
    assert x 3
    val2(x)
    assert x 3
end

start valToRef(int x)
    assert x 2
    = x 4
    assert x 4
    ref2(x)
    assert x 8
end

start refToVal(int & x)
    assert x 2
    = x 5
    assert x 5
    val2(x)
    assert x 5
end

start refToRef(int & x)
    assert x 5
    = x 6
    assert x 6
    ref2(x)
    assert x 8
end

start val2(int x)
    = x 7
end

start ref2(int & x)
    = x 8
end