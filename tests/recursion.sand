import "tests/test_template.sand"

start printNumbers(int n)
    if(n <= 0)
        return
    end
    -- n
    printNumbers(n)
end

@trigger on_init
start main()
    startTest()

    int n 5
    printNumbers(n)
    assert n 5
    load n3 10
    load n4 11
    load n5 19
    load n6 20
    load n7 21
    load n8 22
    load n9 23
    assert n3 4
    assert n4 5
    assert n5 3
    assert n6 2
    assert n7 1
    assert n8 0
    assert n9 0

    endTest()
end