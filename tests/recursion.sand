start printNumbers(int n)
    if(n 0 <=)
        return
    end_if
    -- n
    run printNumbers(n)
end

start main()
    triggers on_init
    env can_exit_on_idle 1
    print "RECURSION_TEST - START\n"
    int n 5
    run printNumbers(n)
    assert n 5
    load n3 3
    load n4 4
    load n5 16
    load n6 17
    load n7 18
    load n8 19
    load n9 20
    assert n3 4
    assert n4 5
    assert n5 3
    assert n6 2
    assert n7 1
    assert n8 0
    assert n9 0
    run incrementPassedTests()
    print "RECURSION_TEST - PASSED\n"
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end