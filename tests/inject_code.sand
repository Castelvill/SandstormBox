import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    string program "
        @trigger on_init
        start injection()
            double a 10
    "

    int i 0
    while(i < 5)
        += program "+= a 13.3\n"
        next i
    end

    += program "
            assert a 76.5
            endTest()
        end
    "

    inject_code self program
end