import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    int sum 0
    int x 23
    int y 7
    int i 0
    int j 0
    while(i < x)
        = j 0
        while(j < y)
            ++ sum
            ++ j
        end
        ++ i
    end
    assert sum 161

    = i 0
    = j 0
    = x 68
    = y 25
    = sum 0

    while(i < x)
        = j 0
        test_loop(sum, j, y)
        ++ i
    end

    assert sum 1700

    endTest()
end

start test_loop(int & sum, int & j, int & y)
    while(j < y)
        ++ sum
        ++ j
    end
end