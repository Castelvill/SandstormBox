start main()
    triggers on_init
    env can_exit_on_idle 1
    print "ASSERT_TEST - START\n"

    assert NULL NULL
    assert a NULL
    assert NULL a
    assert 0 0
    assert 5 5
    
    int a 0
    assert a 0
    assert 0 a
    = a 12
    assert a 12
    assert 12 a

    run incrementPassedTests()
    print "ASSERT_TEST - PASSED\n"
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end