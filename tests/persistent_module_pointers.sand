//Check if modules pointers don't disapear between function calls. Related to "garbage collection" (clearing pointers).

import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    new STexts me 1 "text" text

    var textSize 0

    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0

    fun0()

    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0

    fun1(text)

    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0

    fun2(text)

    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0

    endTest()
end

start fun0()
    return
end

start fun1(SText text)
    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0
end

start fun2(SText & text)
    print_v text_id _ text
    assert text_id "text"
    size text textSize
    assert textSize 1
    = textSize 0
end