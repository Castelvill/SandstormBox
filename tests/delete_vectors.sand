import "tests/test_template.sand"

@trigger on_init
start main()
    run startTest()

    vec int vec0 [5]
    vec int vec1 [10]
    vec int vec2 [15]
    vec int vec3 [20]
    vec int vec4 [25]

    assert vec0 5
    assert vec1 10
    assert vec2 15
    assert vec3 20
    assert vec4 25

    delete vec1

    assert vec0 5
    assert vec1 NULL
    assert vec2 15
    assert vec3 20
    assert vec4 25

    delete vec3

    assert vec0 5
    assert vec1 NULL
    assert vec2 15
    assert vec3 NULL
    assert vec4 25
end

@trigger on_init
start onInit()
    assert vec0 5
    assert vec1 NULL
    assert vec2 15
    assert vec3 NULL
    assert vec4 25
    run endTest()
    delete_this_event
end

@trigger on_idle
start onIdle()
    assert vec0 5
    assert vec1 NULL
    assert vec2 15
    assert vec3 NULL
    assert vec4 25
    delete_this_event
end