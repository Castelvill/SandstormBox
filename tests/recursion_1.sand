import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    int result 0
    int start 1
    int n 5
    doubleNumber(result, start, n)
    //print result "\n"
    assert result 32
    
    endTest()
end

start doubleNumber(int & result, int start, int n)
    if(n <= 0)
        = result start
        return
    end_if
    -- n
    *= start 2
    doubleNumber(result, start, n)
    return
end