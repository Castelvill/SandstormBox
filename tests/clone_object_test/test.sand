import "tests/test_template.sand"

@trigger on_init
start onInit()
    startTest()

    access thisName [me.id]

    new Objects my_layer 1 "Template" Template
    new Variables Template 1 "var0" var0
    fun var0 set_int 15
    new Variables Template 1 "testObjName" testObjName
    fun testObjName set_string thisName

    bind Template ["tests/clone_object_test/template.sand"]
    build Template true
    fun Template deactivate

    int i 0
    var idleLock 0
    
    while(i < 200)
        new Objects my_layer 1 "Clone0" Clone0
        clone Clone0 Template false
        fun Clone0 activate
        ++ idleLock
        next i
    end

end

@trigger each_iteration
start waitForOtherObjects()
    if(idleLock > 0)
        return
    end
    endTest()
    delete_this_event
end