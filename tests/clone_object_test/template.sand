@trigger on_init
start onInit()
    access myName [me.id]
    if(myName == "Template")
        assert 1 0
    end

    ++ var0
    assert var0 16

    decrementLock()

    //print "Hello from " myName ": " var0 "\n"
end

start decrementLock()
    Var idleLock
    first my_layer _ _ _ _ object _ objects
    find_by_id_2 objects testObjName testObj
    first testObj _ _ Variables idleLock _ _ idleLock
    -- idleLock
end