import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    var a 10
    assert a 10
    subFun()
    assert a 15
end

start subFun()
    assert a 10
    = a 15
    assert a 15
end

@trigger on_init
start main1()
    assert a 15
    subFun2()
    assert a 20

    endTest()
end

start subFun2()
    assert a 15
    = a 20
    assert a 20
end
