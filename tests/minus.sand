import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    int a -2
    += a 2
    assert a 0

    var b -5
    += b 5
    assert b 0

    var c 0.0
    fun c set_double_interval -10 -5
    if(c >= -4)
        assert 0 1
    end

    var d -5
    var e -5
    += d -e
    assert d 0

    int f 6
    int g 7
    int h 0
    + -f -g h
    assert h -13

    endTest()
end