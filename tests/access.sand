import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    fun self_layer set_id "TestLayer"
    access self_layer_id [self.layer_id]
    assert self_layer_id "TestLayer"

    access display [display_w display_h]
    type display variableType
    assert variableType "val[]"

    int[] size [640 480]
    assert display size

    int[] vector [10 20 30 40]
    access vectorBack [vector.back]
    assert vectorBack 40
    type vectorBack vectorBackType
    assert vectorBackType "val"

    access objectsN [self_layer.number_of_objects]

    new Object self_layer 1 "TestObj" TestObj

    access objectsN_2 [self_layer.number_of_objects]
    ++ objectsN
    assert objectsN objectsN_2

    access layersN [Process.number_of_layers]
    assert layersN 1

    access objectsN [Process.number_of_objects]
    assert objectsN objectsN_2

    endTest()
end

