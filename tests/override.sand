import "tests/test_template.sand"

@trigger on_init
start main()
    run startTest()
    assert 0 1 //Fail on purpose
    exit
end

@trigger on_init
@override
start main()
    run startTest()

    run func()

    run endTest()
end

start func()
    assert 0 1 //Fail on purpose
end

@override
start func()
    return
end