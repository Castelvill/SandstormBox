start main()
    triggers on_init
    env can_exit_on_idle 1
    print "OVERRIDE_TEST - START\n"
    assert 0 1
    exit
end

override main()
    triggers on_init
    env can_exit_on_idle 1
    print "OVERRIDE_TEST - START\n"
    run func()
    run incrementPassedTests()
    print "OVERRIDE_TEST - PASSED\n"
end

start func()
    assert 0 1
end

override func()
    return
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end