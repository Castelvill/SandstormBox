start main()
    triggers on_init
    env can_exit_on_idle 1
    print "INLINE_TEST - START\n"
    int a 0
    assert a 0
    assert b NULL
    run changeA()
    assert a 10
    assert b NULL
    print "INLINE_TEST - PASSED\n"
end

inline changeA
    int b 20
    = a 5
    assert a 5
    = a 10
    assert b 20
end