import "tests/test_template.sand"

start main()
    triggers on_init
    run startTest()

    int a 5
    assert a 5

    var b 10
    assert b 10
    
    run incA(a)
    assert a 5
    run incB()
    assert b 11
    run incB2(b)
    assert b 11

    run endTest()
end

start incA(int a)
    ++ a
    assert a 6
end

start incB()
    ++ b
    assert b 11
end

start incB2(int b2)
    assert b2 11
    ++ b2
    assert b2 12
    assert b 11
end