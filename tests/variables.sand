start main()
    triggers on_init
    env can_exit_on_idle 1
    print "VARIABLES_TEST - START\n"

    int a 5
    assert a 5

    var b 10
    assert b 10
    
    run incA(a)
    assert a 5
    run incB()
    assert b 11
    run incB2(b)
    assert b 11

    run incrementPassedTests()
    print "VARIABLES_TEST - PASSED\n"
end

start incA(int a)
    ++ a
    assert a 6
end

start incB()
    ++ b
    assert b 11
end

start incB2(int b2)
    assert b2 11
    ++ b2
    assert b2 12
    assert b 11
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end