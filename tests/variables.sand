import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    int a 5
    assert a 5

    var b 10
    assert b 10
    
    incA(a)
    assert a 5
    incB()
    assert b 11
    incB2(b)
    assert b 11

    endTest()
end

start incA(int a)
    ++ a
    assert a 6
end

start incB()
    ++ b
    assert b 11
end

start incB2(int b2)
    assert b2 11
    ++ b2
    assert b2 12
    assert b 11
end