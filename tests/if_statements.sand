start test_if(int & x)
    //print _ _ "for x=" x ": "
    if ([x] [10] <)
        = x 10
    else_if ([x] [50] <)
        if ([x] [40] ==)
            = x 400
        else
            = x 50
        end_if
    else
        if([x] [150] ==)
            = x 1500
            //print _ _ x "\n"
            return
        end_if
        = x 100
    end_if
    //print _ _ x "\n"
end

start main()
    triggers on_init
    env can_exit_on_idle 1

    print "IF_STATEMENT_TEST - START\n"
    
    int x 0
    run test_if(x)
    assert x 10
    = x 20
    run test_if(x)
    assert x 50
    = x 70
    run test_if(x)
    assert x 100
    = x 40
    run test_if(x)
    assert x 400
    = x 150
    run test_if(x)
    assert x 1500

    print "IF_STATEMENT_TEST - PASSED\n"
    exit
end