import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    if(true && false || true == false)
        assert 0 1
    end_if

    if(!true && false)
        assert 0 1
    end_if

    if (!(true || false && false))
        assert 0 1
    end_if

    if ((true || false) && false)
        assert 0 1
    end_if
    
    int x 0
    test_if(x)
    assert x 10
    = x 20
    test_if(x)
    assert x 50
    = x 70
    test_if(x)
    assert x 100
    = x 40
    test_if(x)
    assert x 400
    = x 150
    test_if(x)
    assert x 1500

    endTest()
end

start test_if(int & x)
    //print "for x=" x ": "
    if (x < 10)
        = x 10
    else_if (x < 50)
        if (x == 40)
            = x 400
        else
            = x 50
        end_if
    else
        if(x == 150)
            = x 1500
            //print x "\n"
            return
        end_if
        = x 100
    end_if
    //print x "\n"
end