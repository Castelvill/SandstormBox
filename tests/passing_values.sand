import "tests/test_template.sand"

start main()
    triggers on_init
    run startTest()

    var a 10
    run passA(a)
    run passA2(a)

    run endTest()
end

start passA(int localA)
    ++ localA
    assert localA 11
    assert a 10

    type localA typeOfLocal 
    assert typeOfLocal "Val"

    type a typeOfGlobal
    assert typeOfGlobal "Var"
end

start passA2(Var & localA)
    ++ localA
    assert localA 11
    assert a 11

    type localA typeOfLocal 
    assert typeOfLocal "Var"

    type a typeOfGlobal
    assert typeOfGlobal "Var"
end