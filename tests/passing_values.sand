import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()

    var a 10
    passA(a)
    passA2(a)

    endTest()
end

start passA(int localA)
    ++ localA
    assert localA 11
    assert a 10

    type localA typeOfLocal 
    assert typeOfLocal "val"

    type a typeOfGlobal
    assert typeOfGlobal "var"
end

start passA2(var & localA)
    ++ localA
    assert localA 11
    assert a 11

    type localA typeOfLocal 
    assert typeOfLocal "var"

    type a typeOfGlobal
    assert typeOfGlobal "var"
end