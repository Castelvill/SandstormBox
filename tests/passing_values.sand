start main()
    triggers on_init
    env can_exit_on_idle 1
    print "PASSING_VALUES_TEST - START\n"
    var a 10
    run passA(a)
    run passA2(a)

    run incrementPassedTests()
    print "PASSING_VALUES_TEST - PASSED\n"
end

start passA(int localA)
    ++ localA
    assert localA 11
    assert a 10

    type localA typeOfLocal 
    assert typeOfLocal "Val"

    type a typeOfGlobal
    assert typeOfGlobal "Var"
end

start passA2(Var & localA)
    ++ localA
    assert localA 11
    assert a 11

    type localA typeOfLocal 
    assert typeOfLocal "Var"

    type a typeOfGlobal
    assert typeOfGlobal "Var"
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end