start main()
    triggers on_init
    env can_exit_on_idle 1
    print "RECOMPILATION_TEST - START\n"

    var globalVariable 555
    int localVariable 42

    load_build me ["tests/recompilation_help.sand"]

    assert globalVariable 555
    assert localVariable 42
    
    run incrementPassedTests()
    print "RECOMPILATION_TEST - PASSED\n"
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end