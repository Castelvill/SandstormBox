import "tests/test_template.sand"

@trigger on_init
start main()
    startTest()
    
    new Object self_layer 1 "otherObject" otherObject
    new var otherObject 1 "p0" p0
    fun p0 set_int 15
    
    assert p0 15
    ++ p0
    assert p0 16
end

@trigger on_idle
start onIdle()
    var p0 0
    first self_layer _ "otherObject" var "p0" _ _ p0 //Access variable from object inside a layer
    assert p0 16

    endTest()
    delete_this_event
end