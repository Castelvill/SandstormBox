import "tests/test_template.sand"

start main()
    triggers on_init
    run startTest()
    
    new Objects my_layer 1 "otherObject" otherObject
    new Variables otherObject 1 "p0" p0
    fun p0 set_int 15
    
    assert p0 15
    ++ p0
    assert p0 16
end

start onIdle()
    triggers on_idle

    Var p0
    first my_layer _ "otherObject" Variables "p0" _ _ p0 //Access variable from object inside a layer
    assert p0 16

    run endTest()
    delete_this_event
end