import "tests/test_template.sand"

@trigger on_init
start main()
    run startTest()

    int a 2
    assert a 2
    if()
        int a 5
        assert a 5
    end_if
    assert a 2
    assert b NULL
    run changeA(a)
    assert a 10
    assert b NULL
    
    run endTest()
end

start changeA(int & a)
    assert a 2
    int b 20
    = a 5
    assert a 5
    = a 10
    assert b 20
end