start main()
    triggers on_init
    int x 0
    print _ _ "main-0: " x "\n" 
    run changeVal(x)
    print _ _ "main-1: " x "\n" 
    run changeRef(x)
    print _ _ "main-2: " x "\n" 
    = x 0
    run loop10(x)
    exit
end

start changeVal(int x)
    = x 10
    print _ _ "changeVal: " x "\n"
end

start changeRef(int & x)
    = x 20
    print _ _ "changeRef: " x "\n"
end

loop loop10(int x)
    if([x] [10] <)
    ++ x
    print _ _ x ".\n"
after
    print "Loop finished.\n"
end