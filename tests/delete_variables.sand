import "tests/test_template.sand"

start main()
    triggers on_init
    run startTest()

    var var0 5
    var var1 10
    var var2 15
    var var3 20
    var var4 25

    assert var0 5
    assert var1 10
    assert var2 15
    assert var3 20
    assert var4 25

    delete var1

    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 20
    assert var4 25

    delete var3

    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25

    run endTest()
end

start onInit()
    triggers on_init
    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25
    delete_this_event
end

start onIdle()
    triggers on_idle
    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25
    delete_this_event
end