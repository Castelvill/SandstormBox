import "tests/test_template.sand"

@trigger on_init
start main()
    run startTest()

    var var0 5
    var var1 10
    var var2 15
    var var3 20
    var var4 25

    assert var0 5
    assert var1 10
    assert var2 15
    assert var3 20
    assert var4 25

    delete var1

    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 20
    assert var4 25

    delete var3

    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25

    run endTest()
end

@trigger on_init
start onInit()
    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25
    delete_this_event
end

@trigger on_idle
start onIdle()
    assert var0 5
    assert var1 NULL
    assert var2 15
    assert var3 NULL
    assert var4 25
    delete_this_event
end