start main()
    triggers on_init
    env can_exit_on_idle 1
    print "MEMBER_VARIABLE_TEST - START\n"
    
    var mVar0 30 // Create a member variable for the object that is currently executing this event
    assert mVar0 30
    ++ mVar0

    int_vec mVec0 [0 1 2 3]

    assert mVar0 31
end

start onIdle()
    triggers on_init
    assert mVar0 31
    run incrementPassedTests()
    print "MEMBER_VARIABLE_TEST - PASSED\n"
end

start incrementPassedTests()
    access myName [me.id]
    if(myName "Init" ==)
        return
    end_if
    all Layers _ _ _ _ _ _ layers
    index layers [0 0] object MainTest
    first MainTest _ _ Variables passedTests _ _ passedTests
    ++ passedTests
end