@trigger on_init
start testRunnerEvent()
    env can_exit_on_idle 1
    edit_proc print_instructions 0

    var passedTests 0
    var allTestsCount 0

    print "============================================\n"
    print "RUNNING ALL TESTS - START\n"
    print "============================================\n"

    string path ""

    = path "assert"
    scheduleTest(path)

    = path "literals_and_casting"
    scheduleTest(path) 

    = path "arithmetics"
    scheduleTest(path)

    = path "minus"
    scheduleTest(path)

    = path "on_init/test"
    scheduleTest(path)

    = path "import/test"
    scheduleTest(path)

    = path "access"
    scheduleTest(path)

    = path "if_statements"
    scheduleTest(path)

    = path "reassign"
    scheduleTest(path)

    = path "scopes"
    scheduleTest(path)

    = path "passing_references"
    scheduleTest(path)

    = path "passing_values"
    scheduleTest(path)

    = path "variables"
    scheduleTest(path)

    = path "while_loop"
    scheduleTest(path)

    = path "display"
    scheduleTest(path)

    = path "override"
    scheduleTest(path)

    = path "global"
    scheduleTest(path)

    = path "recursion"
    scheduleTest(path)

    = path "recursion_1"
    scheduleTest(path)
    
    = path "declaration"
    scheduleTest(path)

    = path "tokenize"
    scheduleTest(path)

    = path "recompilation_test/test"
    scheduleTest(path)

    = path "inject_code"
    scheduleTest(path)

    = path "member_variables"
    scheduleTest(path)

    = path "delete_variables"
    scheduleTest(path)
    
    = path "delete_vectors"
    scheduleTest(path)

    = path "persistent_module_pointers"
    scheduleTest(path)

    = path "clone_object_test/test"
    scheduleTest(path)

    = path "clone_layer_test/test"
    scheduleTest(path)
end

start scheduleTest(string & path)
    new Objects my_layer 1 path testCase
    string fullPath "tests/"
    += fullPath path
    += fullPath ".sand"
    bind testCase [fullPath]
    build testCase true
    ++ allTestsCount
end

@trigger on_idle
start on_idle()
    print "============================================\n"
    print "RUNNING ALL TESTS - " passedTests "/" allTestsCount " PASSED\n"
    print "============================================\n"
    exit
end