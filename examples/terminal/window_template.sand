@trigger on_mouse_pressing
start checkIfWindowMoved()
	if (mouse_moved && !isBorderless)
        all Camera _ camera _ cameras
        find_by_id_2 cameras cameraID camera
        revertWindowIfMoved(camera)
        refreshWindowWithCamera()
    end
end

@trigger on_display_resize
start checkIfDisplayResize()
	if (isMaxed)
	    refreshWindowWithDisplay()
    end
end

start revertWindowIfMoved(Camera & camera)
	if (isMaxed && camera.grabbed)
        = isMaxed false
        fun camera set_can_mouse_resize true
        access mouseX [mouse_x]
        access mouseY [mouse_y]
        = posX mouseX
        = posY mouseY
        access sizeXTemp [sizeX]
        /= sizeXTemp 2
        -= posX sizeXTemp
        -= posY 10
        revertBorderIfPossible()
        revertWindowFromMax()
    end
end


start revertBorderIfPossible()
	if (!isBorderless && !isMaxed)
        all Layer _ _ _ _ _ _ layers
        access myLayerID [self.layer_id]
        find_by_id_2 layers myLayerID layer
        index layer [0 0 2] Primitive border
        fun border activate
    end
end

start refreshWindowWithDisplay()
	all Camera _ camera _ cameras
	find_by_id_2 cameras cameraID camera
	access sx [display_w]
	access sy [display_h]
	fun camera resize sx sy
	run refreshWindow(camera, sx, sy)
end

start refreshWindowWithCamera()
	all Camera _ camera _ cameras
	find_by_id_2 cameras cameraID camera
	access sx [camera.size_x]
	access sy [camera.size_y]
	run refreshWindow(camera, sx, sy)
end


start refreshWindow(Camera & camera, double & sx, double & sy)
	int sxShift -100
	+= sxShift sx
	int height 30

    fun camera set_grabbing_area_size sxShift height

    access myLayerID [self.layer_id]
    all Layer _ _ _ _ _ _ layers
    find_by_id_2 layers myLayerID layer

    index layer [0 0 0] Primitive border1
    fun border1 set_size sx sy
    fun border1 update_with_size

    index layer [0 0 1] Primitive border2
    = height 30
    fun border2 set_size sx height
    fun border2 update_with_size

    index layer [0 0 2] Primitive border3
    = sxShift -4
    int syShift -4
    += sxShift sx
    += syShift sy
    fun border3 set_size sxShift syShift
    fun border3 update_with_size

    index layer [0 0 3] Primitive exitButton
    = sxShift -20
    = height 15
    += sxShift sx
    fun exitButton set_pos sxShift height
    fun exitButton update_with_size

    index layer [0 0 0] Collision exitCollision
    fun exitCollision set_pos sxShift height

    index layer [0 0 4] Primitive maxButton
    = sxShift -50
    = height 15
    += sxShift sx
    fun maxButton set_pos sxShift height
    fun maxButton update_with_size

    index layer [0 0 1] Collision maxCollision
    fun maxCollision set_pos sxShift height

    index layer [0 0 5] Primitive minimizeButton
    = sxShift -80
    = height 15
    += sxShift sx
    fun minimizeButton set_pos sxShift height
    fun minimizeButton update_with_size

    index layer [0 0 2] Collision minCollision
    fun minCollision set_pos sxShift height

    if(!isMaxed)
        = sizeX sx
        = sizeY sy
        access cpx [camera.pos_x]
        access cpy [camera.pos_y]
        = posX cpx
        = posY cpy
    end
    additionalUpdate()
end

start additionalUpdate()
    //interface
end

@trigger on_mouse_release
start exitWindow()
    if (mouse_released(0))
        access myLayerID [self.layer_id]
        all Layer _ _ _ _ _ _ layers
        find_by_id_2 layers myLayerID layer
        index layer [0 0 0] Collision exitCollision
        
        if(exitCollision.release_on)
            = removeWindow true
        end
    end
end

@trigger each_iteration
start deleteWindow()
    if (removeWindow && (!has_friends || deleted_friends))
        all Camera _ camera _ cameras
        find_by_id_2 cameras cameraID camera
        delete camera
        delete self_layer
    end
end

@trigger on_mouse_release
start maxWindow()
    if (mouse_released(0))
        access myLayerID [self.layer_id]
        all Layer _ _ _ _ _ _ layers
        find_by_id_2 layers myLayerID layer
        index layer [0 0 1] Collision maxCollision
        if(maxCollision.release_on)
            fun isMaxed toggle_bool
            maxWindowIfTrue()
            refreshWindowWithCamera()
        end
    end
end

start maxWindowIfTrue()
    if(!isMaxed)
        revertWindowFromMax()
        return
    end

    all Layer _ _ _ _ _ _ layers
    access myLayerID [self.layer_id]
    find_by_id_2 layers myLayerID layer
    index layer [0 0 2] Primitive border
    fun border deactivate
    all Camera _ camera _ cameras
    find_by_id_2 cameras cameraID camera
    fun camera set_can_mouse_resize false
    access ww [display_w]
    access wh [display_h]
    fun camera resize ww wh
    fun camera set_relative_position 0 0
end

start revertWindowFromMax()
    all Camera _ camera _ cameras
    find_by_id_2 cameras cameraID camera
    fun camera set_can_mouse_resize true
    fun camera resize sizeX sizeY
    fun camera set_relative_position posX posY
    restart_drag
    revertBorderIfPossible()
end

@trigger on_mouse_release
start minimizeWindow
    if (mouse_released(0))
        access myLayerID [self.layer_id]
        all Layer _ _ _ _ _ _ Layers
        find_by_id_2 Layers myLayerID layer
        index layer [0 0 2] Collision minCollision
        all Camera _ camera _ cameras
        find_by_id_2 cameras cameraID camera
        if(minCollision.release_on)
            fun camera minimize
        end
    end
end

@trigger on_key_press
start switchborderlessMode
    if (key_pressed(KEY_F11))
        all Camera _ camera _ cameras
        find_by_id_2 cameras cameraID camera
        if(camera.is_focused)
            fun isBorderless toggle_bool
            switchToborderless()
        end
    end
end

start switchToborderless()
    if (!isBorderless)
        switchFromborderless()
        return
    end

    fun self set_pos -5 -30
    all Layer _ _ _ _ _ _ layers
    access myLayerID [self.layer_id]
    find_by_id_2 layers myLayerID layer

    index layer [0 0 1] Primitive toolbar
    fun toolbar deactivate
    index layer [0 0 2] Primitive border
    fun border deactivate
    index layer [0 0 3] Primitive exitButton
    fun exitButton deactivate
    index layer [0 0 4] Primitive maxButton
    fun maxButton deactivate
    index layer [0 0 5] Primitive minButton
    fun minButton deactivate
    index layer [0 0 0] TextField title
    fun title deactivate
    index layer [0 0 0] Collision exitCollision
    fun exitCollision deactivate
    index layer [0 0 1] Collision maxCollision
    fun maxCollision deactivate
    index layer [0 0 2] Collision minCollision
    fun minCollision deactivate

    all Camera _ camera _ cameras
    find_by_id_2 cameras cameraID camera
    fun camera set_can_be_grabbed false
    fun camera set_can_mouse_resize false
    access cpx [camera.size_x]
    access cpy [camera.size_y]
    += cpx 10
    += cpy 80
    index Layer [0 0 0] Primitive background
    fun background set_size cpx cpy
    fun background update_with_size
end

start switchFromborderless()
    all Layer _ _ _ _ _ _ layers
    fun self set_pos 0 0
    access myLayerID [self.layer_id]
    find_by_id_2 layers myLayerID layer

    index layer [0 0 1] Primitive toolbar
    fun toolbar activate
    index layer [0 0 3] Primitive exitButton
    fun exitButton activate
    index layer [0 0 4] Primitive maxButton
    fun maxButton activate
    index layer [0 0 5] Primitive minButton
    fun minButton activate
    index layer [0 0 0] TextField title
    fun title activate
    index layer [0 0 0] Collision exitCollision
    fun exitCollision activate
    index layer [0 0 1] Collision maxCollision
    fun maxCollision activate
    index layer [0 0 2] Collision minCollision
    fun minCollision activate

    all Camera _ camera _ cameras
    find_by_id_2 cameras cameraID camera
    fun camera set_can_be_grabbed true
    fun camera set_can_mouse_resize true
    
    revertBorderIfPossible()
end
