@trigger on_key_press
start onKeyPress()
    fs_click()
    exitTerminal()
    rebootTerminal()
    if(program != "edit")
        interrupt()
        autoComplete()
        clearOnShortcut()
        enterCommand()
        moveInHistory()
        format()
    else
        editorOnKeyPress(program, param1)
    end
end

start exitTerminal()
    if(key_pressed(KEY_LCTRL) && key_pressed(KEY_ESC))
        exit
    end
end

start rebootTerminal()
    if(key_pressed(KEY_LCTRL) && key_pressed(KEY_LSHIFT) && key_pressed(KEY_R))
        reboot
    end
end

@trigger on_key_pressing
start onKeyPressing()
    if(program == "edit")
        editorOnKeyPressing()
    end
end

@trigger on_key_release
start onKeyRelease()
    if(program == "edit")
        editorOnKeyPressing()
    end
end

@trigger on_mouse_pressing
start onMousePressing()
    if (program != "edit" || !mouse_pressing(0))
        return
    end
    index self [EDITOR_OBJ_IDX EDITOR_TEXT_FIELD_IDX] EditableText editorTextField
    selectTextWithMouse(editorTextField)
    refreshLineNumbering(editorTextField)
end

start toggleRelativeNumbering()
    if(key_pressed(KEY_LSHIFT) && key_pressed(KEY_LCTRL) && key_pressed(KEY_N))
        if(relativeNumbering)
            = relativeNumbering false
        else
            = relativeNumbering true
        end
    end
end

start resizeDisplay()
    if (used_os == "windows")
        env display_size 640 480
        edit_proc window_size 640 480
    else_if (used_os == "linux" && !fullscreen)
        env display_size 920 480
        edit_proc window_size 920 480
    else_if(fullscreen)
        env display_size 1920 1080
    end
end


start loadCommandHistory(string & fileName)
    if(!exists(fileName))
        return
    end
    load_text fileName loadedText
    val[] loadedTextTokenized
    tokenize "\n" loadedText loadedTextTokenized
    fun commandHistory clear
    fun commandHistory push_back loadedTextTokenized
    access newSize [commandHistory.size]
    -- newSize
    = commandNumber newSize
    = currentCommandNumber newSize
end

