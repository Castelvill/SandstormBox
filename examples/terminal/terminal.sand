start interrupt()
    if (!key_pressed(KEY_LSHIFT) && key_pressed(KEY_LCTRL) && key_pressed(KEY_C))
        = program ""
        string result "^C\n"
        printOnTerminal(result)
    end
end

start autoComplete()
    if (!key_pressed(KEY_TAB) || program != "sleep")
        return
    end
    index Camera [0] Camera camera
    if (!camera.is_selected)
        return
    end

    index self [0 0] EditableText editableText
    string userInput ""
    access userInput [editableText.content]
    int userInputSize 0
    len userInput userInputSize
    fun editableText set_cursor_pos userInputSize

    fun editableText set_last_color 1.0 0.8 0.0 1.0
    fun editableText set_last_accent_color 0.0 0.0 0.0 1.0

    int protectedArea 0
    access protectedArea [editableText.protected_area]
    substr userInput protectedArea userInputSize command
    val[] params
    tokenize " " command params
    autoCompleteProgramsOrFiles(params, command)
end

start autoCompleteFiles(string & command, val[] & params)
    access lastParameter [params.back]
    count "/" lastParameter depth
    ++ depth
    ls "" files true depth
    val[] filesTokenized
    tokenize " " files filesTokenized
    val[] completes
    similar lastParameter filesTokenized false completes
    similar lastParameter filesTokenized true commonPart
    string result "\n"
    int i 0
    if(completes.size == 1 && is_directory(completes))
        print_v completes _ completes "/"
    else_if(completes.size == 1)
        print_v completes _ completes " "
    end
    replaceWithAutoComplete(command, params, completes, commonPart, lastParameter)
end

start autoCompleteProgramsOrFiles(val[] & params, string & command)
    if(params.size == 1)
        //Auto complete programs
        val[] completes
        similar command allowedPrograms false completes
        similar command allowedPrograms true commonPart
        string lastParameter ""
        = lastParameter command
        string result "\n"
        int i 0
        if(completes.size == 1)
            print_v completes _ completes " "
        end
        replaceWithAutoComplete(command, params, completes, commonPart, lastParameter)
    else
        autoCompleteFiles(command, params)
    end
end

start replaceWithAutoComplete(string & command, val[] & params, val[] & completes, string & commonPart, string & lastParameter)
    index self [0 0] EditableText editableText
    if (completes.size == 1)
        fun editableText cut_unprotected_area
        fun params pop_back
        fun params push_back completes
        print_v autocompletedText " " params
        //index completes [0] value instance
        fun editableText add_content autocompletedText
        //fun editableText update
        access history [editableText.content]
        len history historySize
        fun editableText set_cursor_pos historySize
    else_if(completes.size > 0)
        int i 0
        string result "\n"
        while (i < completes.size)
            index completes [i] value instance
            += result instance
            += result " "
            ++ i
        end
        += result "\n"
        cout(result)
        printPrompt()
        addCommonPartToCommand(command, completes, commonPart, lastParameter)
        rewriteLastCommand(command, editableText)
        //run updateTerminal()
    end
end

start createPrompt(string & result)
    //Cool way of creating prompt is not possible until extended ascii characters are not handled well in the editable text module.
    += result "~/"      //"┌/"
    pwd workingDir
    += result workingDir
    += result "\n$"     //"\n└─$"
end

start printPrompt()
    string result ""
    index self [0 0] EditableText editableText
    fun editableText set_last_color terminalColorR terminalColorG terminalColorB terminalColorA
    fun editableText set_last_accent_color terminalAccentColorR terminalAccentColorG terminalAccentColorB terminalAccentColorA
    string result ""
    createPrompt(result)
    cout(result)
    colorNormalText(editableText)
end

start addCommonPartToCommand(string & command, val[] & completes, string & commonPart, string & lastParameter)
    if(completes.size > 0)
        len lastParameter lastParameterLength
        len commonPart commonPartLength
        -= commonPartLength lastParameterLength
        substr commonPart lastParameterLength commonPartLength commonPart
        += command commonPart
    end
end

start rewriteLastCommand(string & command, EditableText & editableText)
    fun editableText add_content command
    //fun editableText update
    access history [editableText.content]
    len history historySize
    fun editableText set_cursor_pos historySize
end

@trigger each_iteration
start controler()
    if (program != "")
        return
    end
    index self [0 0] EditableText editableText
    fun editableText set_last_color terminalColorR terminalColorG terminalColorB terminalColorA
    fun editableText set_last_accent_color terminalAccentColorR terminalAccentColorG terminalAccentColorB terminalAccentColorA
    = program "sleep"
    string result ""
    createPrompt(result)
    cout(result)
    colorNormalText(editableText)
end


start clearOnShortcut()
    if (program == "sleep" && key_pressed(KEY_LCTRL) && key_pressed(KEY_L))
        index Camera [0] Camera camera
        if (camera.is_selected)
            cls()
        end
    end
end

@trigger each_iteration
start controlerWithEnter()
    if (program != "_enter")
        return
    end
    index self [0 0] EditableText editableText
    fun editableText set_last_color terminalColorR terminalColorG terminalColorB terminalColorA
    fun editableText set_last_accent_color terminalAccentColorR terminalAccentColorG terminalAccentColorB terminalAccentColorA
    = program "sleep"
    string result "\n"
    createPrompt(result)
    cout(result)
    colorNormalText(editableText)
    updateTerminal()
end

start colorNormalText(EditableText & editableText)
    fun editableText set_last_color 0.86 0.85 0.86 1.0
    fun editableText set_last_accent_color 0.0 0.0 0.0 1.0
    string result " "
    printOnTerminal(result)
end


start fs_click()
    if (key_pressed(KEY_F12))
        setFullscreen()
    end
end

start fullscreen()
    = program ""
    setFullscreen()
end

start fs()
    = program ""
    setFullscreen()
end

start setFullscreen()
    if (!fullscreen)
        env fullscreen 1
    else
        env fullscreen 0
    end
end

start adjustTerminalToDisplay()
    access windowWidth [display_w]
    access windowHeight [display_h]
    
    index Camera [0] Camera Cam0
    fun Cam0 resize windowWidth windowHeight
    index self [0 0] Image background
    fun background resize windowWidth windowHeight

    index self [0 0] EditableText terminalTextField
    access terminalSizeY [terminalTextField.size_y]
    fun terminalTextField set_size windowWidth terminalSizeY
    fun terminalTextField update
    fun terminalTextField crop_height_to_text
    access terminalSizeY [terminalTextField.size_y]
    if(terminalSizeY < windowHeight)
        fun terminalTextField set_size windowWidth windowHeight
    end
    
    refreshScrollbar()
end

start forceRefresh()
    //TODO: Extract common part because there must be something in common or it stops working
    adjustTerminalToDisplay()
    
    if (program != "edit")
        
    else
        adjustTextEditorToDisplay()
    end
end

@trigger on_display_resize
start refresh()
    forceRefresh()
end

start refreshScrollbar()
    index self [0 0] EditableText terminalTextField
    access terminalSizeY [terminalTextField.size_y]
    access h [display_h]
    -= terminalSizeY h

    = scrollbarHeight h
    index self [0 0] Scrollbar mainScrollbar
    access windowW [display_w]
    int scrollbarWidth 16
    -= windowW scrollbarWidth
    fun mainScrollbar set_pos windowW 0
    fun mainScrollbar resize scrollbarWidth h
    int thumbWidth 12
    fun mainScrollbar set_scrolling_area thumbWidth h
    fun mainScrollbar set_thumb_size thumbWidth h

    all self _ _ Image _ _ _ allImages
    find_by_id_2 allImages "thumb_track" trackImage
    fun trackImage resize scrollbarWidth h
    fun self update_scrollbars

    refreshScrollbarCheck(h, terminalSizeY)
end

start refreshScrollbarCheck(double & height, double & terminalSizeY)
    if(terminalSizeY > 0)
        index self [0 0] Scrollbar MainScrollbar
        fun MainScrollbar set_real_scrolling_area 0 terminalSizeY
        += terminalSizeY height
        double currentThumbHeight BASE_SCROLLBAR_HEIGHT
        = currentThumbHeight scrollbarHeight
        access windowH [display_h]
        double divide 1.0
        = divide windowH
        /= divide terminalSizeY
        *= currentThumbHeight divide
        fun MainScrollbar set_thumb_size 12 currentThumbHeight
        fun MainScrollbar scroll_to_the_end
        fun self update_scrollbars
        keepMinimalSizeOfScrollThumb(MainScrollbar, currentThumbHeight)
    else
        resetScrollbar()
    end
end

start keepMinimalSizeOfScrollThumb(Scrollbar & MainScrollbar, double & currentThumbHeight)
    if(currentThumbHeight < minScrollbarThumbHeight)
        = currentThumbHeight minScrollbarThumbHeight 
        fun MainScrollbar set_thumb_size 12 currentThumbHeight
        fun self update_scrollbars
    end
end

start resetScrollbar()
    index self [0 0] Scrollbar MainScrollbar
    double currentThumbHeight BASE_SCROLLBAR_HEIGHT
    = currentThumbHeight scrollbarHeight
    fun MainScrollbar set_thumb_size 12 currentThumbHeight
    fun self update_scrollbars
end


start enterCommand()
    if (!key_pressed(KEY_ENTER) || program != "sleep")
        return
    end

    index Camera [0] Camera camera
    if (!camera.is_selected)
        return
    end
    index self [0 0] EditableText editableText
    first editableText _ _ _ _ content _ userInput
    first editableText _ _ _ _ protected_area _ protectedArea
    len userInput userInputSize
    substr userInput protectedArea userInputSize command

    len command commandLength

    = param0 ""
    = param1 ""
    = param2 ""
    = param3 ""
    = param4 ""
    = param5 ""
    = param6 ""
    = param7 ""

    tokenize " " command [param0 param1 param2 param3 param4 param5 param6 param7]

    in param0 allowedPrograms isAllowed
    = program "_enter"
    string lastCommand ""
    ignoreRepetition(lastCommand)
    saveCommand(command, commandLength, lastCommand)
    validateAndRunProgram(isAllowed)
    = currentCommandNumber commandNumber
end

start ignoreRepetition(string & lastCommand)
    if(commandNumber > 0)
        //dump_context_stack
        //breakpoint
        int lastParameterIndex commandNumber
        -- lastParameterIndex
        index commandHistory [0 lastParameterIndex] value lastCommand
    end
end

start saveCommand(string & command, int & commandLength, string & lastCommand)
    if (commandLength > 0 && command != lastCommand)
        fun commandHistory set commandNumber command
        save_text "~/history.txt" commandHistory "\n"
        fun commandHistory push_back ""
        ++ commandNumber
    end
end

start validateAndRunProgram(bool & isAllowed)
    if (isAllowed)
        string run "run "
        += run param0
        = program "run"
        inject_instr self run
        string result "\n"
        cout(result)
    else
        programNotFound()
    end
end


start reboot()
    reboot
end


start forgor()
    = commandNumber 0
    = currentCommandNumber 0
    fun commandHistory clear
    save_text "history.txt" commandHistory
    fun commandHistory push_back ""
    = program ""
end

start moveInHistory()
    if(program == "sleep")
        index Camera [0] Camera camera
        upArrow(camera)
        downArrow(camera)
    end
end

start upArrow(Camera & camera)
    if (camera.is_selected && key_pressed(KEY_UP) && program == "sleep" && currentCommandNumber > 0)
        index self [0 0] EditableText editableText
        first editableText _ _ _ _ content _ userInput
        first editableText _ _ _ _ protected_area _ protectedArea
        len userInput userInputSize
        substr userInput protectedArea userInputSize command
        fun commandHistory set currentCommandNumber command

        -- currentCommandNumber
        //dump_memory
        fun editableText cut_unprotected_area
        string diffCommand ""
        index_vec commandHistory currentCommandNumber diffCommand
        fun editableText add_content diffCommand
        fun editableText update
        access history [editableText.content]
        len history historySize
        fun editableText set_cursor_pos historySize
    end
end


start downArrow(Camera & camera)
    if (camera.is_selected && key_pressed(KEY_DOWN) && program == "sleep" && currentCommandNumber < commandNumber)
        index self [0 0] EditableText editableText
        first editableText _ _ _ _ content _ userInput
        first editableText _ _ _ _ protected_area _ protectedArea
        len userInput userInputSize
        substr userInput protectedArea userInputSize command
        fun commandHistory set currentCommandNumber command

        ++ currentCommandNumber

        fun editableText cut_unprotected_area
        string diffCommand ""
        index_vec commandHistory currentCommandNumber diffCommand
        fun editableText add_content diffCommand
        fun editableText update
        access history [editableText.content]
        len history historySize
        fun editableText set_cursor_pos historySize
    end
end


start programNotFound()
    if (param0 != "")
        string result "\nCommand not found!"
        printOnTerminal(result)
    end
end

start edit()
    openTextEditor(program, param1)
end

start sand()
	if(param1 != "" && exists(param1))
        load_build self param1
        = program ""
	else 
        emptyInput1()
    end
end
start emptyInput1()
    if(param1 == "")
        = program ""
        string result "Error: This instruction requires 1 parameter!\n"
        printOnTerminal(result)
    else
        informFileDoesNotExistForSand()
    end
end
start informFileDoesNotExistForSand()
    = program ""
    string result "Error: File '"
    += result param1
    += result "' does not exist.\n"
    printOnTerminal(result)
end


start injectFormat(int & startFragment, int & endFragment)
    index self [0 0] EditableText editableText
    string font "cascadia_code"
    fun editableText inject_format startFragment endFragment 1.0 0.0 1.0 1.0  1.0 0.0 1.0 1.0 font
end

start format()
    if(key_pressed(KEY_LCTRL) && key_pressed(5))
        index self [0 0] EditableText Terminal
        access cursorPos [Terminal.cursor_pos]
        access secondCursorPos [Terminal.second_cursor_pos]
        formatCheck(cursorPos, secondCursorPos)
    end
end 

start formatCheck(int & cursorPos, int & secondCursorPos)
    int startFragment 0
    int endFragment 0
    if (cursorPos < secondCursorPos)
        = startFragment cursorPos
        = endFragment secondCursorPos
    else
        = startFragment secondCursorPos
        = endFragment cursorPos
    end
    injectFormat(startFragment, endFragment)
end


start save_terminal()
    index self [0 0] EditableText terminalTextField
    fun terminalTextField save_to_file param1
    = program ""
end

start load_terminal()
    index self [0 0] EditableText terminalTextField
    fun terminalTextField load_from_file param1
    = program ""
end

start mkdir()
	= program ""
	if(param1 == "")
		string txt "Cannot create a directory with an empty name!\n"
		cout(txt)
		return
	end
	if(exists(param1))
		string txt ""
		print_v txt _ "Directory with name '" param1 "' already exists!\n"
		cout(txt)
		return
	end
	mkdir param1
end
