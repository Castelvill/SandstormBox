@trigger on_init
start putRectangleOnScreen
    var DISPLAY_W 640
    var DISPLAY_H 480
    access display_w [display_w]
    access display_h [display_h]
    = DISPLAY_W display_w
    = DISPLAY_H display_h
    create_display DISPLAY_W DISPLAY_H DISPLAY_W DISPLAY_H

    var SIZE_X 120
    var SIZE_Y 100
    var x 10.0
	var y 10.0
    var velX 4.0
    var velY 4.0

    new Primitive self 1 "Rectangle" rectangle
    fun rectangle create "filled_rectangle"
    fun rectangle set_color 1.0 0.0 0.0 1.0
    fun rectangle set_pos x y
    fun rectangle set_size SIZE_X SIZE_Y
    fun rectangle update_with_size

    load_font "fonts/CascadiaCode.ttf" 16 "cascadia_code_2" true

    new TextField self 1 "Fps" FpsText
    fun FpsText disable_scrolling
    fun FpsText set_pos 400 0
    fun FpsText set_size 400 50
    fun FpsText add_format "cascadia_code_2" 1
    fun FpsText set_color 0 0.0 1.0 0.0 1.0
    fun FpsText set_wrapping "n"
    fun FpsText set_content "FPS"
end

@trigger on_display_resize
start updateFiledWithResize
    access display_w [display_w]
    access display_h [display_h]
    = DISPLAY_W display_w
    = DISPLAY_H display_h

    = x 10.0
	= y 10.0
end

@trigger each_second
start printFPS
    all self _ _ TextField _ _ _ texts
    find_by_id_2 texts "Fps" FpsText
    access fpsValue [fps]
    string fpsString "FPS: "
    += fpsString fpsValue
    fun FpsText set_content fpsString
	fun FpsText update
end

@trigger each_iteration
start moveRectangle
    double xs 0.0
    double ys 0.0
    + x SIZE_X xs
    + y SIZE_Y ys
    if(x <= 0 || xs >= DISPLAY_W)
        *= velX -1.0
    end
    if(y <= 0 || ys >= DISPLAY_H)
        *= velY -1.0
    end
	+= x velX
	+= y velY
    //index self 0 0 primitives Rectangle
    all self _ _ Primitive _ _ _ primitives
	find_by_id_2 primitives "Rectangle" rectangle
    fun rectangle set_pos x y
end


