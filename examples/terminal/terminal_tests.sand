start newLine
    string result "\n"
    run printOnTerminal(result)
end
start nextTest
    run printPrompt()
    run newLine()
end
start testSpawn
    = param1 "elephant"
    run spawn()
end
start testNote
    = param1 "examples/hello.sand"
    run note()
end
start testMover
    = param1 "KERNEL"
    run mover()
end
start testCat
    = param1 ".config"
    run cat()
end
start testPrint
    = param1 "TEST TEST TEST\n"
    run print()
end
start testEdit
    = param1 "docs/TODO.txt"
    run edit()
end
start testSand
    = param1 "scripts/terminal/lorem.sand"
    run sand()
end
start testCd
    = param1 "scripts"
    run cd()
end
start testCd2
    = param1 ""
    run cd()
end
start testSaveLoadTerminal
    mkdir "temp"
    = param1 "temp/test.ft"
    run save_terminal()
    run load_terminal()
end
start dvd
    = param1 "scripts/terminal/dvd.sand"
    run sand()
end
start test
    run help()
    run nextTest()
    run neofetch()
    run nextTest()
    run nextTest()
    run hello()
    run nextTest()
    run ls()
    run nextTest()
    run sq()
    run nextTest()
    run cats()
    run nextTest()
    run fullscreen()
    run fs()
    run nw()
    run testNote()
    run testMover()
    run testSpawn()
    run v4()
    run testCat()
    run nextTest()
    run testPrint()
    run nextTest()
    run testEdit()
    run triggerEditorExit()
    run testSand()
    run nextTest()
    run testCd()
    run pwd()
    run nextTest()
    run xd()
    run nextTest()
    run allegro()
    run nextTest()
    run testCd2()
    run testSaveLoadTerminal()
    run dvd()
    //run cls()
end