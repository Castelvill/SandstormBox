start newLine
    string result "\n"
    printOnTerminal(result)
end
start nextTest
    printPrompt()
    newLine()
end
start testSpawn
    = param1 "elephant"
    spawn()
end
start testNote
    = param1 "examples/hello.sand"
    note()
end
start testMover
    = param1 "KERNEL"
    mover()
end
start testCat
    = param1 ".config"
    cat()
end
start testPrint
    = param1 "TEST TEST TEST\n"
    run print()
end
start testEdit
    = param1 "docs/TODO.txt"
    edit()
end
start testSand
    = param1 "examples/terminal/lorem.sand"
    sand()
end
start testCd
    = param1 "scripts"
    run cd()
end
start testCd2
    = param1 ""
    run cd()
end
start testSaveLoadTerminal
    mkdir "temp"
    = param1 "temp/test.ft"
    save_terminal()
    load_terminal()
end
start dvd
    = param1 "examples/terminal/dvd.sand"
    sand()
end
start test
    help()
    nextTest()
    neofetch()
    nextTest()
    nextTest()
    hello()
    nextTest()
    run ls()
    nextTest()
    sq()
    nextTest()
    cats()
    nextTest()
    fullscreen()
    fs()
    nw()
    testNote()
    testMover()
    testSpawn()
    v4()
    testCat()
    nextTest()
    testPrint()
    nextTest()
    testEdit()
    triggerEditorExit(program)
    testSand()
    nextTest()
    testCd()
    run pwd()
    nextTest()
    xd()
    nextTest()
    allegro()
    nextTest()
    testCd2()
    testSaveLoadTerminal()
    dvd()
    //run cls()
end