@trigger on_init
start init
    edit_proc print_instructions 0
    fun me set_can_be_selected false
    new Objects my_layer 1 "KERNEL" First
    fun First set_can_be_selected true
    fun First set_can_be_moved_with_mouse true
    fun First enable_selection_border
    //fun First disable_scrolling
    rbind First
    bind First ["examples/terminal/terminal.sand" "examples/terminal/terminal_help.sand" "examples/terminal/terminal_tests.sand"]
    build First true
end
