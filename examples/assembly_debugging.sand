stop_assembling
start_printing_tokens

@trigger on_init
start main()
    fn0(fn1())
    print "abc"
    exit
end

start fn0()
    print 0
    return
end

start fn1()
    print 1
    return
end

start fn2()
    print 2
    return
end

start fn3()
    print 3
    return
end

start fn4()
    print 4
    return
end

resume_assembling
stop_printing_tokens

@trigger on_init
start exit()
    exit
end
