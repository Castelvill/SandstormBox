@trigger on_init
start createLines
    int windowWidth 640
    int windowHeight 480
    create_display windowWidth windowHeight windowWidth windowHeight

    new Camera 1 "Camera" camera
    fun camera resize windowWidth windowHeight
    fun camera add_visible_layer "KERNEL"

    //Create random polygon
    new Primitive self 1 "polygon" polygon
    fun polygon set_type "polygon"
    fun polygon set_color 1.0 0.0 0.0 1.0
    fun polygon add_point 20 20
    fun polygon add_point 100 100
    fun polygon add_point 70 200
    fun polygon add_point 30 150

    //Define points for a hexagon
    double[] hexagonPoints [1 0 0.5 0.8660254038 -0.5 0.8660254038 -1 0 -0.5 -0.8660254038 0.5 -0.8660254038]
    *= hexagonPoints 50

    //Create hexagon
    new Primitive self 1 "hexagon" hexagon
    fun hexagon set_type "polygon"
    fun hexagon set_thickness 10
    fun hexagon set_line_join_type 1
    fun hexagon set_color 0.0 1.0 0.0 1.0
    fun hexagon set_pos 200 100

    int i 0
    double x 0.0
    double y 0.0
    while(i < 12)
        index_vec hexagonPoints i x
        next i
        index_vec hexagonPoints i y
        fun hexagon add_point x y
        next i
    end

    //Create filled hexagon
    new Primitive self 1 "filledHexagon" filledHexagon
    fun filledHexagon set_type "filled_polygon"
    fun filledHexagon set_color 0.0 0.0 1.0 1.0
    fun filledHexagon set_pos 350 100

    = i 0
    = x 0.0
    = y 0.0
    while(i < 12)
        index_vec hexagonPoints i x
        next i
        index_vec hexagonPoints i y
        fun filledHexagon add_point x y
        next i
    end


    //Create pyramid
    new Primitive self 1 "pyramid" pyramid
    fun pyramid set_type "polygon"
    fun pyramid set_thickness 1
    fun pyramid set_line_join_type 1
    fun pyramid set_color 1.0 1.0 0.0 1.0
    fun pyramid set_pos 200 250
    
    = i 0
    = x 0
    bool mode false
    while(i < 25)
        fun pyramid add_point 0 x
        if(mode)
            fun pyramid move_point i x 0
            = mode false
        else
            fun pyramid move_point i -x 0
            = mode true
        end
        += x 6
        next i
    end
end
