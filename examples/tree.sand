@trigger on_init
start main()
    int height 5
    int i 0
    while(i < height)
        int space height
        -= space i
        -- space
        int j 0

        while(j < space)
            print " "
            ++ j
        end

        int stars 2
        *= stars i
        += stars 1
        int k 0

        while(k < stars)
            print "*"
            ++ k
        end

        print "\n"
        ++ i
    end

    // Tree trunk
    int t 0
    while(t < 2)
        int s 0
        int heigh_minus height
        -- heigh_minus

        while(s < heigh_minus)
            print " "
            ++ s
        end
        
        print "*\n"
        ++ t
    end

    exit
end