@trigger on_init
start main()
    int i 0
    int j 0
    while(i < 10)
        print i " -> "

        if(i == 3)
            ++ i
            print "(continue 1)\n"
            continue
        end

        = j 0

        while(j < 10)

            if(i == 5 && j < 3)
                ++ j
                print "(continue 2)"
                continue
            end

            print j " "

            if(j == 8)
                print "(break)"
                break
            end

            ++ j
        end

        print "\n"
        ++ i
    end

    exit
end