@trigger on_init
start main()
    int[] colors []

    int i 0
    while(i < 100)
        double r 0
        double g 0
        double b 0
        random_double 0 0.5 r
        random_double 0 0.5 g
        random_double 0 0.5 b
        fun colors push_back r
        fun colors push_back g
        fun colors push_back b
        fun colors push_back 1.0
        next i
    end

    print_d " " colors "\n" 
    exit
end