// Example of compiling code at runtime. In this example the print instruction will be added 5 times
// to the injection event.

@trigger on_init
start main()
    string program "
        @trigger on_init
        start injection()
    "

    int i 0
    while(i < 5)
        += program "print \"Hello, World!\n\"\n"
        next i
    end

    += program "
            exit
        end
    "

    inject_code me program
end