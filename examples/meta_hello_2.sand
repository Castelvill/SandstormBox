//Example of cloning events

@trigger on_init
start test()
    var a 0

    Event originalHello
    all me _ _ Events _ _ _ allEvents
    find_by_id_2 allEvents "hello" originalHello

    int i 0
    while(i 4 <)
        new Events me 1 "hello0" newEvent
        clone newEvent originalHello false
        next i
    end_while()
end

@trigger on_init
start hello()
    print "hello " a "\n"
    ++ a
end

@trigger on_idle
start exit()
    exit
end