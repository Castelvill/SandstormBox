@trigger on_init
start quickMath
    int a 2
    print "a = 2\n"
    int b 4
    print "a = 4\n"
    int c 0
    + a b c
    print "a + b = " c "\n"

    * a b c
    print "a * b = " c "\n"

    ** a b c
    print "a ** b = " c "\n\n"

    int_vec vecA [0 1 2 3 4 5 6 7]
    print "vecA = [ 0 1 2 3 4 5 6 7 ]\n"
    += vecA vecA
    print "vecA += vecA\n"
    print "vecA: [ "
    print_d " " vecA "]"
    print "\n"

    int vecB 0
    + vecA 10 vecB
    print "vecA + 10 = [ "
    print_d " " vecB "]\n"

    exit
end