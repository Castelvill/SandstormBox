@trigger on_init
start on_init()
    var counter 0
    var idleCounter 1
    print "Init...\n"
end

@trigger each_second
start each_second()
    = idleCounter 1
    ++ counter
    print "\nSecond has passed..." counter "\n"
    if(counter == 3)
        exit
    end_if
end

@trigger on_idle
start on_idle()
    print "(idle " idleCounter ") " 
    ++ idleCounter
    int modulo 0
    % idleCounter 11 modulo
    if(modulo == 0)
        print "\n"
    end_if
end