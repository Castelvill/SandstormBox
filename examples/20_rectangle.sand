@trigger on_init
start createRectangles
    int windowWidth 640
    int windowHeight 480
    create_display windowWidth windowHeight windowWidth windowHeight

    new Camera 1 "Camera" camera
    fun camera resize windowWidth windowHeight
    fun camera add_visible_layer "KERNEL"

    //Create rectangle by adding points - adding points by hand should be only used for polygons
    new Primitive self 1 "rectangle0" rectangle0
    fun rectangle0 set_type "filled_rectangle"
    fun rectangle0 add_point 20.0 20.0
    fun rectangle0 add_point 150.0 120.0
    fun rectangle0 set_color 1.0 0.0 0.0 1.0

    //Create rectangle with the 'create' function - simpler version
    new Primitive self 1 "rectangle1" rectangle1
    fun rectangle1 create "filled_rectangle"
    fun rectangle1 set_color 0.0 1.0 0.0 1.0
    fun rectangle1 set_pos 200 50
    fun rectangle1 set_size 200 150
    //Map primitive's points positions to the module's position and size
    fun rectangle1 update_with_size

    print "To close this program use the CTRL+ESC shortcut or just click the exit button.\n"
end

@trigger on_key_press
start exitProgram
    if(key_pressed(KEY_LCTRL) && key_pressed(KEY_ESC))
        exit
    end
end